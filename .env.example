# Copiar a .env (que está en .gitignore, nunca se sube) y completar.

# API key gratuita de Roboflow (app.roboflow.com -> Settings -> API Keys)
ROBOFLOW_API_KEY=

# GPU sin pycuda (Windows): la libreria `inference` de Roboflow pide
# CUDAExecutionProvider/OpenVINOExecutionProvider/CoreMLExecutionProvider y
# nunca prueba DirectML aunque este disponible -- hay que pedirselo a mano.
# Requiere tener instalado `onnxruntime-directml` (no `onnxruntime` a secas
# ni `onnxruntime-gpu`) -- ver requirements-video.txt.
ONNXRUNTIME_EXECUTION_PROVIDERS=DmlExecutionProvider,CPUExecutionProvider
